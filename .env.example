# Modèle : copier ce fichier en .env et remplacer les valeurs
MONGO_ROOT_USER=a_definir
MONGO_ROOT_PASSWORD=a_changer

# Base de données
MONGO_DB=healthcare_db

# Compte de l'application Python (lecture + écriture sur MONGO_DB)
MONGO_APP_USER=app_etl
MONGO_APP_PASSWORD=un_autre_mot_de_passe

# Compte analyste (lecture seule sur MONGO_DB)
MONGO_ANALYSTE_USER=analyste
MONGO_ANALYSTE_PASSWORD=encore_un_autre_mot_de_passe